{
  "about": "A section dragged across the Time & Loops waveform of a 60 s cue: shaded, then M puts slice markers on both edges; a second section cropped with Shift-I and Shift-O; a plain click clears it.",
  "show": "Demo",
  "media": {"media/a.wav": 60},
  "window": {"width": 1200, "height": 800},
  "steps": [
    {"select": "1"},
    {"tab": "timeLoops"},
    {"advance": 0.5},
    {"drag": "time-loops-waveform", "from": [0.6, 0.5], "to": [0.3, 0.5]},
    {"shot": "section-shaded"},
    {"key": "m"},
    {"advance": 0.2},
    {"shot": "section-sliced"},
    {"drag": "time-loops-waveform", "from": [0.1, 0.5], "to": [0.85, 0.5]},
    {"key": "i", "modifiers": ["shift"]},
    {"key": "o", "modifiers": ["shift"]},
    {"advance": 0.2},
    {"shot": "section-cropped"},
    {"click": "time-loops-waveform", "at": [0.5, 0.5]},
    {"advance": 0.2},
    {"shot": "section-cleared-by-click"}
  ]
}
