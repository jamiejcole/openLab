{
  "about": "A cue on a patch given 128 cue outputs: its Levels tab with a fader, value box and meter per output, scrolled to output 100 where a route and a level are typed, playing with its meters lit; then the window at its least size, and the Fade aimed at it with all 128 outputs, one typed.",
  "show": "Demo",
  "media": {"media/a.wav": 30},
  "window": {"width": 1200, "height": 800},
  "steps": [
    {"focus": "settings"},
    {"tab": "audio"},
    {"click": "settings-patch-edit-1"},
    {"focus": "patch-editor"},
    {"type": "patch-editor-count", "text": "128"},
    {"focus": "workspace"},
    {"select": "1"},
    {"tab": "levels"},
    {"shot": "levels-128"},
    {"scroll": "levels-matrix", "dx": -4300},
    {"shot": "levels-128-scrolled"},
    {"double_click": "levels-matrix", "at": [0.7795, 0.615]},
    {"type": "levels-field", "text": "0"},
    {"double_click": "levels-matrix", "at": [0.7795, 0.128]},
    {"type": "levels-field", "text": "-6"},
    {"key": "space"},
    {"select": "1"},
    {"advance": 0.5},
    {"shot": "levels-128-playing"},
    {"resize": [800, 500]},
    {"advance": 0.2},
    {"shot": "levels-128-least"},
    {"scroll": "levels-matrix", "dx": 6000},
    {"shot": "levels-128-least-back"},
    {"resize": [1200, 800]},
    {"select": "fade intro"},
    {"tab": "fadeLevels"},
    {"shot": "fade-128"},
    {"scroll": "fade-matrix", "dx": -4300},
    {"double_click": "fade-matrix", "at": [0.7795, 0.128]},
    {"type": "fade-field", "text": "-20"},
    {"shot": "fade-128-typed"}
  ]
}
