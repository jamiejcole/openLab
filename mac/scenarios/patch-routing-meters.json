{
  "about": "Cue 1 routed to cue output 1 on its Levels tab and played; in the patch editor cue output 1 is taken off device output 1 (emptied) and sent to device output 2: row 1's meter moves though device output 1 is silent, and row 2 stays dark.",
  "show": "Demo",
  "media": {
    "media/a.wav": 30
  },
  "steps": [
    {
      "select": "1"
    },
    {
      "tab": "levels"
    },
    {
      "double_click": "levels-matrix",
      "at": [
        0.534,
        0.615
      ]
    },
    {
      "type": "levels-field",
      "text": "0"
    },
    {
      "shot": "levels-routed"
    },
    {
      "key": "space"
    },
    {
      "advance": 1
    },
    {
      "focus": "settings"
    },
    {
      "tab": "audio"
    },
    {
      "click": "settings-patch-edit-1"
    },
    {
      "focus": "patch-editor"
    },
    {
      "tab": "routing"
    },
    {
      "advance": 1
    },
    {
      "shot": "meters-mapped"
    },
    {
      "double_click": "patch-editor-matrix",
      "at": [
        0.47,
        0.47
      ]
    },
    {
      "type": "patch-editor-crosspoint-field",
      "text": ""
    },
    {
      "double_click": "patch-editor-matrix",
      "at": [
        0.553,
        0.47
      ]
    },
    {
      "type": "patch-editor-crosspoint-field",
      "text": "0"
    },
    {
      "advance": 1
    },
    {
      "shot": "meters-routed-off-mapping"
    }
  ]
}
