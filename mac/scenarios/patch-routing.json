    {"double_click": "patch-editor-matrix", "at": [0.553, 0.47]},
    {"type": "patch-editor-crosspoint-field", "text": "-12"},
    {"shot": "routing-two-outputs"},
    {"tab": "deviceOutputs"},
    {"shot": "device-outputs"},
    {"type": "patch-editor-device-field-2", "text": "-12"},
    {"click": "patch-editor-device-mute-2"},
