    {"tab": "routing"},
    {"shot": "routing-device-output-muted"},
    {"click": "patch-editor-unmute"},
    {"shot": "routing-unmuted"},
    {"choose": "patch-editor-copy", "item": "Defaults"},
    {"shot": "routing-defaults"},
