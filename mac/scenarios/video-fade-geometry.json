{
  "about": "A Fade cue aimed at a Video cue (#647): its tabs (Curve, Levels for a target with sound, Geometry), the Geometry tab with nothing ticked, then opacity to 0 and the position ticked and typed, relative mode, the stop flag; a Fade aimed at a silent Video cue (no Levels tab); the Fade previewed while the movie plays (the target fading); the window at its least size.",
  "show": "VideoSound",
  "displays": "V1:1920x1080",
  "media": {
    "media/talk.mov": {"seconds": 20, "sound": "pcm:2:48000"},
    "media/tracks.mov": {"seconds": 6, "sound": "pcm:2:48000+pcm:6:44100"},
    "media/silent.mov": 4,
    "media/still.png": 1,
    "media/tone.wav": 10
  },
  "window": {"width": 1200, "height": 800},
  "steps": [
    {"advance": 0.2},
    {"select": "5"},
    {"tab": "fadeGeometry"},
    {"shot": "untouched"},
    {"click": "fade-geometry-opacity-tick"},
    {"type": "fade-geometry-opacity", "text": "0"},
    {"click": "fade-geometry-position-tick"},
    {"type": "fade-geometry-x", "text": "400"},
    {"type": "fade-geometry-y", "text": "-150"},
    {"shot": "opacity-and-position-ticked"},
    {"click": "fade-geometry-scale-tick"},
    {"click": "fade-geometry-scale-lock"},
    {"type": "fade-geometry-scale-y", "text": "0.5"},
    {"click": "fade-geometry-rotation-tick"},
    {"type": "fade-geometry-rotation", "text": "30"},
    {"click": "fade-geometry-stop-target"},
    {"shot": "every-value-ticked-stop-target"},
    {"choose": "fade-geometry-mode", "item": "Relative"},
    {"shot": "relative"},
    {"choose": "fade-geometry-mode", "item": "Absolute"},
    {"click": "fade-geometry-stop-target"},
    {"tab": "curve"},
    {"shot": "curve-tab"},
    {"select": "6"},
    {"tab": "fadeGeometry"},
    {"shot": "silent-target-no-levels-tab"},
    {"select": "1"},
    {"key": "space"},
    {"advance": 0.5},
    {"select": "5"},
    {"tab": "fadeGeometry"},
    {"click": "fade-geometry-preview"},
    {"advance": 1.0},
    {"shot": "previewed-fading"},
    {"resize": [800, 500]},
    {"shot": "least-window"}
  ]
}
