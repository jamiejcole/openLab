{
  "about": "Cue 1 plays while the group is closed and opened with the arrow keys, each time followed at once by a change of the columns: the window to its least size and back, the sidebar shown and hidden, Show Mode on and off. Every row's cells stay in the current columns.",
  "show": "Demo",
  "media": {"media/a.wav": 30},
  "window": {"width": 1300, "height": 820},
  "steps": [
    {"select": "1"},
    {"key": "space"},
    {"advance": 1},
    {"select": "2"},
    {"shot": "playing"},
    {"key": "left"},
    {"resize": [800, 500]},
    {"advance": 0.3},
    {"shot": "closed-least"},
    {"key": "right"},
    {"click": "toggle-sidebar"},
    {"advance": 0.3},
    {"shot": "opened-least-sidebar"},
    {"key": "left"},
    {"click": "mode-switch", "at": [0.75, 0.5]},
    {"advance": 0.3},
    {"shot": "closed-least-sidebar-show-mode"},
    {"key": "right"},
    {"resize": [1300, 820]},
    {"advance": 0.3},
    {"shot": "opened-wide-show-mode"},
    {"key": "left"},
    {"click": "mode-switch", "at": [0.25, 0.5]},
    {"advance": 0.3},
    {"shot": "closed-wide-edit"},
    {"key": "right"},
    {"click": "toggle-sidebar"},
    {"advance": 0.3},
    {"shot": "opened-wide-no-sidebar"}
  ]
}
