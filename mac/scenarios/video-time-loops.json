{
  "about": "A Video cue's Time & Loops tab (#646): a movie with no sound shows the time ruler alone with the keep-last-frame box; trimmed (the Duration cell follows); looped; kept on its last frame; built-in fades; a slice; playing inside the loop (the playhead line); a still; a cue with no file.",
  "show": "Video",
  "displays": "V1:1920x1080",
  "media": {
    "media/clip.mov": 4,
    "media/still.png": 1,
    "media/card.jpg": 1,
    "media/A very long name for a projection clip used in the second act.mov": 2
  },
  "window": {"width": 1200, "height": 800},
  "steps": [
    {"advance": 0.1},
    {"select": "1"},
    {"tab": "timeLoops"},
    {"shot": "movie"},
    {"type": "time-loops-start", "text": "1"},
    {"type": "time-loops-end", "text": "3"},
    {"advance": 0.1},
    {"shot": "trimmed"},
    {"click": "time-loops-loop"},
    {"click": "time-loops-hold-at-end"},
    {"click": "time-loops-fades"},
    {"advance": 0.1},
    {"shot": "looped-held-fades"},
    {"click": "time-loops-waveform", "at": [0.5, 0.5]},
    {"click": "time-loops-add-slice"},
    {"advance": 0.1},
    {"shot": "sliced"},
    {"key": "space"},
    {"advance": 4.3},
    {"select": "1"},
    {"tab": "timeLoops"},
    {"shot": "playing-in-loop"},
    {"advance": 0.6},
    {"shot": "playing-in-loop-later"},
    {"key": "escape"},
    {"advance": 2},
    {"select": "2"},
    {"shot": "still"},
    {"select": "4"},
    {"shot": "no-file"}
  ]
}
